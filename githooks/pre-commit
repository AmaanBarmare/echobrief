#!/bin/sh
# Blocks any commit that takes the codebase off-brand or logs a credential.
# Escape hatch for a genuine one-off: git commit --no-verify
node scripts/brand-check.mjs || {
  echo ""
  echo "Commit blocked by brand-check. Fix the violations above, or"
  echo "add a // brand-check-ignore comment if the exception is deliberate."
  exit 1
}
node scripts/secret-log-check.mjs || exit 1
